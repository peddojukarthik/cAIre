# cAIre — environment variables
#
# This file is a TEMPLATE only. Never fill in real values here and commit
# it — copy it to `.env.local` for local testing (already covered by
# .gitignore) and set the real values in Vercel's dashboard for deployment
# (Project Settings > Environment Variables), or via:
#   vercel env add <NAME>

# --- Supabase -------------------------------------------------------------
# Find these in your Supabase project: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings > JWT Keys > "Legacy JWT Secret" tab
# (Supabase now also offers newer asymmetric "JWT Signing Keys" -- use the
# Legacy tab specifically, since our auth.py verifies with HS256.)
SUPABASE_JWT_SECRET=your-jwt-secret

# Project Settings > Database > Connection info > "Transaction pooler" tab
# (NOT the "Direct connection" tab -- Vercel's serverless functions open
# many short-lived connections, which the pooler is built for. Note the
# username includes your project ref, unlike the direct-connection user.)
SUPABASE_DB_HOST=aws-0-your-region.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# --- Google AI Studio -------------------------------------------------------
# Get a free API key at https://aistudio.google.com/apikey (no card required)
GOOGLE_AI_API_KEY=your-google-ai-studio-api-key

# --- Aadhaar hashing --------------------------------------------------------
# A random salt used only to hash Aadhaar numbers for uniqueness checks.
# Generate once with: openssl rand -hex 32
# Never reuse this across environments; never store the raw Aadhaar number.
AADHAAR_HASH_SALT=generate-with-openssl-rand-hex-32

# --- Document signing (replaces Cloud KMS) ----------------------------------
# Generate a key pair once with: python -m app.services.signing
# Paste the PRIVATE key PEM here, with actual newlines replaced by literal \n
# so it fits on one line (Vercel env vars are single strings). Example shape:
DOCUMENT_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGHAgEA...\n-----END PRIVATE KEY-----\n"
